  <title>Letso Mabeo | Digital Portfolio</title>
  <style>
    :root {
      --navy: #14283f;
      --teal: #087e83;
      --gold: #f2b84b;
      --cream: #fffaf0;
      --white: #ffffff;
      --text: #263746;
      --muted: #5d6b76;
      --black: #000000;
    }

    * {
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--cream);
      color: var(--text);
      font-family: Arial, sans-serif;
      line-height: 1.7;
    }

    header {
      padding: 56px 20px 36px;
      text-align: center;
      color: var(--white);
      background: linear-gradient(135deg, var(--navy), var(--teal));
    }

    header h1 {
      margin: 0;
      color: var(--white);
      font-size: clamp(2.2rem, 6vw, 3.5rem);
    }

    header p {
      margin: 8px 0 22px;
      font-size: 1.1rem;
      color: var(--gold);
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
    }

    nav a {
      padding: 8px 13px;
      border: 1px solid rgba(255, 255, 255, 0.55);
      border-radius: 20px;
      color: var(--white);
      text-decoration: none;
    }

    nav a:hover,
    nav a:focus {
      background: var(--gold);
      border-color: var(--gold);
      color: var(--navy);
    }

    main {
      width: min(960px, 92%);
      margin: 35px auto;
    }

    section {
      margin: 24px 0;
      padding: 26px;
      border-radius: 14px;
      background: var(--white);
      box-shadow: 0 5px 18px rgba(20, 40, 63, 0.08);
    }

    h2 {
      margin-top: 0;
      padding-bottom: 8px;
      border-bottom: 3px solid var(--gold);
      color: var(--teal);
    }

    h3 {
      color: var(--navy);
    }

    .tag {
      display: inline-block;
      margin: 4px;
      padding: 5px 11px;
      border-radius: 18px;
      background: #e4f3f1;
      color: var(--teal);
      font-size: 0.9rem;
      font-weight: bold;
    }

    .project {
      margin-top: 16px;
      padding: 18px;
      border-left: 5px solid var(--gold);
      border-radius: 8px;
      background: #f7faf9;
    }

    a {
      color: var(--teal);
    }

    .button {
      display: inline-block;
      margin-top: 8px;
      padding: 10px 16px;
      border-radius: 6px;
      background: var(--teal);
      color: var(--white);
      text-decoration: none;
      font-weight: bold;
    }

    .button:hover,
    .button:focus {
      background: var(--navy);
    }

    footer {
      padding: 22px;
      text-align: center;
      background: var(--navy);
      color: var(--white);
    }

    footer a {
      color: var(--gold);
    }

    @media (max-width: 600px) {
      section {
        padding: 20px;
      }

      nav a {
        font-size: 0.9rem;
      }
    }
  </style>
</head>

